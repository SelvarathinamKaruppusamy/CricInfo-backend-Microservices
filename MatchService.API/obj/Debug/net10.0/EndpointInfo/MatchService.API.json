{
  "openapi": "3.0.4",
  "info": {
    "title": "MatchService.API",
    "version": "1.0"
  },
  "paths": {
    "/api/matches/live": {
      "get": {
        "tags": [
          "Match"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/matches/ball": {
      "post": {
        "tags": [
          "Match"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BallUpdateDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/BallUpdateDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/BallUpdateDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BallUpdateDto": {
        "type": "object",
        "properties": {
          "matchNo": {
            "type": "integer",
            "format": "int32"
          },
          "ballResult": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Match"
    }
  ]
