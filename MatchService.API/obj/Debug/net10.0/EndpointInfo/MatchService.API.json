{
  "openapi": "3.0.4",
  "info": {
    "title": "MatchService.API",
    "version": "1.0"
  },
  "paths": {
    "/api/matches/live": {
      "get": {
        "tags": [
          "Match"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/matches/ball": {
      "post": {
        "tags": [
          "Match"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BallUpdateDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/BallUpdateDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/BallUpdateDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/matches/change-bowler": {
      "put": {
        "tags": [
          "Match"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeBowlerDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeBowlerDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeBowlerDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/matches/toss": {
      "put": {
        "tags": [
          "Match"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TossDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/TossDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/TossDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/matches/start/{matchNo}": {
      "put": {
        "tags": [
          "Match"
        ],
        "parameters": [
          {
            "name": "matchNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/matches/start-second-innings/{matchNo}": {
      "put": {
        "tags": [
          "Match"
        ],
        "parameters": [
          {
            "name": "matchNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/matches/balls/{matchNo}": {
      "get": {
        "tags": [
          "Match"
        ],
        "parameters": [
          {
            "name": "matchNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BallUpdateDto": {
        "type": "object",
        "properties": {
          "matchNo": {
            "type": "integer",
            "format": "int32"
          },
          "ballResult": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ChangeBowlerDto": {
        "type": "object",
        "properties": {
          "matchNo": {
            "type": "integer",
            "format": "int32"
          },
          "bowlerPlayerId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "TossDto": {
        "type": "object",
        "properties": {
          "matchNo": {
            "type": "integer",
            "format": "int32"
          },
          "tossWinner": {
            "type": "string",
            "nullable": true
          },
          "tossDecision": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Match"
    }
  ]
}